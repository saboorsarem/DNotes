# Keep line endings sane across contributors. Text is normalised to LF in the
# repository; Windows checkouts get CRLF, which is what the .csproj and the
# build expect.
* text=auto

# PowerShell is only ever run on Windows, so let it keep CRLF unconditionally.
*.ps1  text eol=crlf
*.cmd  text eol=crlf
*.bat  text eol=crlf

# Source and project files: LF in the repo, CRLF on a Windows checkout.
*.cs        text eol=crlf
*.csproj    text eol=crlf
*.sln       text eol=crlf
*.config    text eol=crlf
*.txt       text eol=crlf
*.md        text eol=crlf
*.yml       text eol=crlf
*.gitignore text eol=crlf
LICENSE     text eol=crlf

# Never touch these.
*.png  binary
*.ico  binary
*.exe  binary
*.zip  binary
